# Loker Agent Environment Variables
# Copy this file to .env and fill in your values

# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key-here

# Application environment: development, production, testing
LOKER_ENV=development

# Database Configuration
LOKER_DATABASE_URL=sqlite:///data/loker.db

# API Keys
LOKER_API_KEY=your-api-key-here

# Logging
LOKER_LOG_LEVEL=INFO
LOKER_LOG_FILE=logs/loker.log

# Scraping Settings
LOKER_SCRAPE_INTERVAL=3600
LOKER_MAX_JOBS_PER_SOURCE=100

# Email Configuration (optional)
LOKER_SMTP_HOST=smtp.gmail.com
LOKER_SMTP_PORT=587
LOKER_SMTP_USER=your-email@gmail.com
LOKER_SMTP_PASSWORD={encrypted: your-encrypted-password}

# Proxy Settings (optional)
LOKER_PROXY_ENABLED=false
LOKER_PROXY_URL=http://proxy.example.com:8080
